# Copy to .env (never commit real values). All have safe defaults for local development.

# --- Database (production profile: SPRING_PROFILES_ACTIVE=postgres) ---
DB_URL=jdbc:postgresql://localhost:5432/crusher_erp
DB_USER=postgres
DB_PASSWORD=change_me
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=change_me

# --- Platform admin (creates projects and API keys). Long random value. Blank disables /admin ---
NOTIFY_BOOTSTRAP_ADMIN_KEY=change_me_long_random
# Secret mixed into OTP hashes. Required in production.
NOTIFY_OTP_PEPPER=change_me_long_random

# --- AWS (use an IAM role in production; keys are for local/LocalStack only) ---
AWS_REGION=ap-south-1
# AWS_ENDPOINT=http://localhost:4566        # LocalStack only; leave unset for real AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Providers: log (default, no AWS calls) or aws (SES + SNS) ---
NOTIFY_PROVIDER_MODE=log
SES_DEFAULT_SENDER=no-reply@your-verified-domain.example
SES_CONFIGURATION_SET=
SMS_DEFAULT_SENDER_ID=

# --- Queue (optional; when disabled the engine delivers in-process and the DB sweeper retries) ---
NOTIFY_QUEUE_ENABLED=false
NOTIFY_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/notify-prod
NOTIFY_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/notify-prod-dlq

# --- Feature flags ---
NOTIFY_EMAIL_ENABLED=true
NOTIFY_SMS_ENABLED=true
NOTIFY_PUSH_ENABLED=false
NOTIFY_PUSH_CHANNEL_ENABLED=false

# --- Policy ---
NOTIFY_RETRY_MAX_ATTEMPTS=5
NOTIFY_RETENTION_DAYS=90
NOTIFY_CONTACT_RETENTION_DAYS=7
